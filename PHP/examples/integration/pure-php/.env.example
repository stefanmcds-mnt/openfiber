# OpenFiber Configuration for Pure PHP

# Service Name
OPENFIBER_SERVICE_NAME=default

# WSDL Configuration
OPENFIBER_WSDL_URL=https://gateway.openfiber.it/wsdl/default.wsdl
OPENFIBER_USERNAME=your_username
OPENFIBER_PASSWORD=your_password

# Retry Configuration
OPENFIBER_RETRY_ENABLED=true
OPENFIBER_RETRY_MAX_ATTEMPTS=3

# Circuit Breaker Configuration
OPENFIBER_CB_ENABLED=true
OPENFIBER_CB_FAILURE_THRESHOLD=5
OPENFIBER_CB_TIMEOUT=60

# Connection Settings
OPENFIBER_CONNECTION_TIMEOUT=30
